# ─────────────────────────────────────────────────────────────────────────────
# AI Real Estate Designer — configuratie
# Kopieer naar .env.local en vul in wat u wilt gebruiken. Alles is optioneel:
# zonder configuratie werkt de app volledig lokaal (opslag in de browser) en
# zonder AI (handmatige 2D-editor, 3D, inrichten, PDF-export).
# Zet NOOIT geheime sleutels in variabelen met het voorvoegsel NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────────────────────

# ── Cloudopslag, accounts en deellinks (Supabase) ────────────────────────────
# Zonder deze twee waarden draait de app in 'lokale modus' (IndexedDB).
NEXT_PUBLIC_SUPABASE_URL=
# Publieke anon/publishable key (bedoeld voor de browser; toegang wordt bepaald door RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Alleen server-side, nodig voor beveiligde deellinks (/api/share/[token]).
# Geeft volledige databasetoegang: nooit in de browser of in git.
SUPABASE_SERVICE_ROLE_KEY=

# ── AI: beeldanalyse en ontwerpassistent (Anthropic Claude) ──────────────────
# Betaald API-account vereist: https://console.anthropic.com
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Optioneel: ander model of andere denkdiepte (low | medium | high | xhigh | max)
ANTHROPIC_MODEL=claude-opus-5-5
AI_EFFORT=medium

# ── AI: beeldgeneratie voor virtual staging (optioneel) ──────────────────────
# OpenAI-compatibel image-edit endpoint. Betaald account vereist.
# Zonder deze waarden kunt u extern gestagede beelden uploaden en vergelijken.
IMAGE_PROVIDER=
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-1
IMAGE_API_URL=https://api.openai.com/v1/images/edits

# ── Externe 3D-/plattegrondreconstructie (optioneel) ─────────────────────────
# Zie docs/architecture.md voor het verwachte request/response-contract.
RECONSTRUCTION_API_URL=
RECONSTRUCTION_API_KEY=
