# ─────────────────────────────────────────────────────────────────────────────
# AI News Agent — configuratie. Kopieer naar .env.local en vul in.
# Zonder ANTHROPIC_API_KEY werkt de app in 'basismodus': nieuws wordt wel
# verzameld, gefilterd en ontdubbeld, maar zonder AI-samenvattingen, kansen en
# uitleg. Zet geheime sleutels NOOIT in variabelen met het voorvoegsel NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────────────────────

# ── AI-analyse (Anthropic Claude) ── betaald account: https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optioneel: ander model of andere denkdiepte (low | medium | high | xhigh | max)
ANTHROPIC_MODEL=claude-opus-5-5
AI_EFFORT=medium

# ── Opslag ── SQLite-bestand; in Docker op een volume zetten
DATABASE_PATH=./data/news.db

# ── Planning ──
# De ingebouwde planner controleert elke minuut of de nieuwsbrief van vandaag al
# gemaakt is (tijdstip en tijdzone stel je in via Instellingen). Zet op false als
# je liever een externe cron gebruikt die /api/cron aanroept.
SCHEDULER_ENABLED=true
# Geheim voor /api/cron (Authorization: Bearer <CRON_SECRET>). Leeg = endpoint uit.
CRON_SECRET=

# ── E-mail (optioneel, via Resend: https://resend.com) ──
RESEND_API_KEY=
EMAIL_FROM=AI News Agent <nieuws@jouwdomein.nl>
# Publieke URL van het dashboard, voor de link onderaan de e-mail
PUBLIC_URL=

# ── Optioneel: wachtwoord voor het dashboard (HTTP Basic Auth) ──
# Aanbevolen zodra je de app online zet. Gebruikersnaam is vrij.
DASHBOARD_PASSWORD=
