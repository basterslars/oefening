# ─────────────────────────────────────────────────────────────────────────────
# Persoonlijke AI-studieassistent — configuratie
# Kopieer naar .env.local en vul in. Zet NOOIT geheime sleutels in variabelen
# met het voorvoegsel NEXT_PUBLIC_ (die komen in de browser terecht).
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (verplicht): database, inloggen en documentopslag ──────────────
NEXT_PUBLIC_SUPABASE_URL=
# Publieke anon/publishable key. Toegang wordt afgedwongen door Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# De app gebruikt GEEN service-role key; die is niet nodig.

# ── AI (Claude API) ─────────────────────────────────────────────────────────
# Zonder sleutel werken: vakken, uploads, uitlezen, zoeken, flashcards (handmatig),
# planner, voortgang en de regelgebaseerde coach. AI-functies zijn dan uitgeschakeld.
ANTHROPIC_API_KEY=

# Modelkeuze per rol (zie README → Kosten).
# AI-docent en coach-evaluatie:
AI_MODEL_TUTOR=claude-opus-5-5
# Oefententamens en flashcards genereren:
AI_MODEL_GENERATE=claude-opus-5-5
# Documentanalyse en open vragen nakijken (bulk, goedkoop):
AI_MODEL_FAST=claude-haiku-5-5

# Denkdiepte per rol: low | medium | high | xhigh | max
AI_EFFORT_TUTOR=medium
AI_EFFORT_GENERATE=medium
AI_EFFORT_FAST=low

# Harde limiet op tokens (input + output) per gebruiker per dag.
AI_DAILY_TOKEN_BUDGET=1500000
# Documenten bij upload laten samenvatten en onderwerpen laten herkennen (1 goedkope aanroep per document).
AI_ANALYZE_DOCUMENTS=true
# Bij een weigering door het model automatisch een ander model laten proberen (server-side fallback).
AI_REFUSAL_FALLBACKS=true

# ── Semantisch zoeken (optioneel) ───────────────────────────────────────────
# none = full-text zoeken in Postgres (gratis). voyage = hybride met embeddings (pgvector).
EMBEDDING_PROVIDER=none
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5

# ── Overig ──────────────────────────────────────────────────────────────────
# Tijdzone voor "vandaag", dagdoelen en planning.
APP_TIMEZONE=Europe/Amsterdam
